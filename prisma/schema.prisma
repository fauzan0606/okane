generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Currency {
  id String @id @default(uuid())
  code String @unique
  name String
  symbol String
  decimalPlaces Int
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallets Wallet[]
  receivables Receivable[]
  budgets Budget[]
  investmentAssets InvestmentAsset[]
  investmentTransactions InvestmentTransaction[]
}

model Wallet {
  id String @id @default(uuid())
  name String
  walletType WalletType
  currencyId String
  currentBalance Decimal @default(0)
  balanceAsOf DateTime?
  bank String?
  color String?
  icon String?
  note String?
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creditCard CreditCardProfile?
  currency Currency @relation(fields: [currencyId], references: [id])
  transactions Transaction[]
  receivablePayments ReceivablePayment[]
  sourceReceivables Receivable[] @relation("ReceivableSourceWallet")
  transfersFrom Transfer[] @relation("TransferFromWallet")
  transfersTo Transfer[] @relation("TransferToWallet")
  reconciliations ReconciliationSession[]
  investmentCashMovements InvestmentCashMovement[]
  investmentTransactionsAsFunding InvestmentTransaction[] @relation("InvestmentFundingWallet")
  @@index([currencyId])
}

model CreditCardProfile {
  id String @id @default(uuid())
  walletId String @unique
  creditLimit Decimal @default(0)
  billingDate Int
  dueDate Int
  rewardProgram String?
  rewardPoint Decimal @default(0)
  annualFee Decimal?
  annualFeeDate Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  statements CreditCardStatement[]
}

model CreditCardStatement {
  id String @id @default(uuid())
  creditCardId String
  periodStart DateTime
  periodEnd DateTime
  statementDate DateTime
  dueDate DateTime
  calculatedAmount Decimal @default(0)
  actualAmount Decimal?
  paidAmount Decimal @default(0)
  paidAt DateTime?
  paymentTransactionId String?
  status CreditCardStatementStatus @default(UNPAID)
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  creditCard CreditCardProfile @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  payments CreditCardStatementPayment[]
  @@unique([creditCardId, periodStart, periodEnd])
  @@index([creditCardId, dueDate])
}

model CreditCardStatementPayment {
  id String @id @default(uuid())
  statementId String
  amount Decimal
  paidAt DateTime
  note String?
  transferId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  statement CreditCardStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  transfer Transfer? @relation("CreditCardPaymentTransfer", fields: [transferId], references: [id], onDelete: SetNull)
  @@index([statementId, paidAt])
}

model Category {
  id String @id @default(uuid())
  name String
  type CategoryType
  icon String?
  color String?
  isSystem Boolean @default(false)
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subcategories Subcategory[]
  transactions Transaction[]
  budgetItems BudgetItem[]
}

model Subcategory {
  id String @id @default(uuid())
  categoryId String
  name String
  isSystem Boolean @default(false)
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgetItems BudgetItem[]
  @@unique([categoryId, name])
  @@index([categoryId, isActive, sortOrder])
}

model Payee {
  id String @id @default(uuid())
  name String
  note String?
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
}

model Transaction {
  id String @id @default(uuid())
  transactionDate DateTime
  type TransactionType
  kind TransactionKind @default(STANDARD)
  amount Decimal
  note String?
  walletId String
  wallet Wallet @relation(fields: [walletId], references: [id])
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id])
  payeeId String?
  payee Payee? @relation(fields: [payeeId], references: [id])
  installmentPlan InstallmentPlan?
  receivablePayment ReceivablePayment?
  splitBill SplitBill?
  transferFee Transfer? @relation("TransferFee")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transfer {
  id String @id @default(uuid())
  transferDate DateTime
  fromWalletId String
  toWalletId String
  amount Decimal
  feeAmount Decimal @default(0)
  origin TransferOrigin @default(MANUAL)
  feeTransactionId String? @unique
  fromWallet Wallet @relation("TransferFromWallet", fields: [fromWalletId], references: [id])
  toWallet Wallet @relation("TransferToWallet", fields: [toWalletId], references: [id])
  feeTransaction Transaction? @relation("TransferFee", fields: [feeTransactionId], references: [id], onDelete: SetNull)
  creditCardPayment CreditCardStatementPayment? @relation("CreditCardPaymentTransfer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([transferDate])
  @@index([fromWalletId, transferDate])
  @@index([toWalletId, transferDate])
  @@index([origin, transferDate])
}

model InstallmentPlan {
  id String @id @default(uuid())
  transactionId String @unique
  totalAmount Decimal
  feeAmount Decimal @default(0)
  installmentAmount Decimal
  tenorMonths Int
  startDate DateTime
  status InstallmentPlanStatus @default(ACTIVE)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([startDate, status])
}

model SplitBill {
  id String @id @default(uuid())
  merchantName String
  transactionId String? @unique
  totalAmount Decimal
  personalAmount Decimal
  status SplitBillStatus @default(DRAFT)
  note String?
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  participants SplitBillParticipant[]
  items SplitBillItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model SplitBillParticipant {
  id String @id @default(uuid())
  splitBillId String
  name String
  isMe Boolean @default(false)
  shareAmount Decimal @default(0)
  splitBill SplitBill @relation(fields: [splitBillId], references: [id], onDelete: Cascade)
  allocations SplitBillItemAllocation[]
  receivable Receivable?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([splitBillId, isMe])
}

model SplitBillItem {
  id String @id @default(uuid())
  splitBillId String
  name String
  quantity Decimal @default(1)
  unitPrice Decimal
  splitMethod SplitBillItemMethod @default(EQUAL)
  splitBill SplitBill @relation(fields: [splitBillId], references: [id], onDelete: Cascade)
  allocations SplitBillItemAllocation[]
  @@index([splitBillId])
}

model SplitBillItemAllocation {
  id String @id @default(uuid())
  itemId String
  participantId String
  units Decimal @default(0)
  amount Decimal @default(0)
  item SplitBillItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participant SplitBillParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  @@unique([itemId, participantId])
  @@index([participantId])
}

model Receivable {
  id String @id @default(uuid())
  personName String
  description String
  amount Decimal
  receivedAmount Decimal @default(0)
  currencyId String
  sourceWalletId String?
  loanDate DateTime @default(now())
  dueDate DateTime?
  status ReceivableStatus @default(OUTSTANDING)
  sourceTransactionId String?
  splitBillParticipantId String? @unique
  currency Currency @relation(fields: [currencyId], references: [id])
  sourceWallet Wallet? @relation("ReceivableSourceWallet", fields: [sourceWalletId], references: [id], onDelete: SetNull)
  splitBillParticipant SplitBillParticipant? @relation(fields: [splitBillParticipantId], references: [id], onDelete: SetNull)
  payments ReceivablePayment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, dueDate])
  @@index([currencyId, status])
  @@index([sourceWalletId, status])
}

model ReceivablePayment {
  id String @id @default(uuid())
  receivableId String
  amount Decimal
  receivedAt DateTime
  walletId String
  transactionId String @unique
  note String?
  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  @@index([receivableId, receivedAt])
}

model Budget {
  id String @id @default(uuid())
  name String
  currencyId String
  periodStart DateTime
  periodEnd DateTime
  totalAmount Decimal?
  note String?
  currency Currency @relation(fields: [currencyId], references: [id])
  items BudgetItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([currencyId, periodStart, periodEnd])
  @@index([currencyId, periodStart, periodEnd])
}

model BudgetItem {
  id String @id @default(uuid())
  budgetId String
  categoryId String?
  subcategoryId String?
  amount Decimal
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([budgetId, categoryId])
  @@index([budgetId, subcategoryId])
}

model ReconciliationSession {
  id String @id @default(uuid())
  walletId String
  sourceType ReconciliationSourceType
  status ReconciliationSessionStatus @default(REVIEWING)
  fileName String
  periodStart DateTime?
  periodEnd DateTime?
  extractedCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  rows ReconciliationRow[]
  @@index([walletId, createdAt])
}

model ReconciliationRow {
  id String @id @default(uuid())
  sessionId String
  sourceSide ReconciliationSourceSide
  sourceRowNumber Int?
  pageNumber Int?
  transactionDate DateTime
  description String
  amount Decimal
  direction ReconciliationDirection
  entryType String?
  matchStatus ReconciliationMatchStatus
  matchConfidence Int @default(0)
  matchReason String?
  matchedTransactionId String?
  matchedTransferId String?
  resolution ReconciliationResolution @default(PENDING)
  createdTransactionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session ReconciliationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, matchStatus])
  @@index([matchedTransactionId])
  @@index([matchedTransferId])
  @@index([transactionDate, amount])
}

model InvestmentProvider {
  id String @id @default(uuid())
  name String
  countryCode String
  websiteUrl String?
  note String?
  isActive Boolean @default(true)
  accounts InvestmentAccount[]
  feeRules InvestmentFeeRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([name, countryCode])
}

model InvestmentAccount {
  id String @id @default(uuid())
  providerId String
  name String
  accountType InvestmentAccountType
  currencyId String
  accountNumberMasked String?
  note String?
  isActive Boolean @default(true)
  provider InvestmentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id])
  cashAccount InvestmentCashAccount?
  holdings InvestmentHolding[]
  transactions InvestmentTransaction[]
  @@index([providerId, isActive])
}

model InvestmentCashAccount {
  id String @id @default(uuid())
  accountId String @unique
  balance Decimal @default(0)
  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  movements InvestmentCashMovement[]
  transactions InvestmentTransaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvestmentCashMovement {
  id String @id @default(uuid())
  cashAccountId String
  movementType InvestmentCashMovementType
  amount Decimal
  movementDate DateTime
  sourceWalletId String?
  investmentTransactionId String?
  note String?
  cashAccount InvestmentCashAccount @relation(fields: [cashAccountId], references: [id], onDelete: Cascade)
  sourceWallet Wallet? @relation(fields: [sourceWalletId], references: [id], onDelete: SetNull)
  investmentTransaction InvestmentTransaction? @relation(fields: [investmentTransactionId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([cashAccountId, movementDate])
}

model InvestmentAsset {
  id String @id @default(uuid())
  symbol String?
  name String
  assetType InvestmentAssetType
  countryCode String?
  currencyId String
  unitName String
  purity Decimal?
  note String?
  isActive Boolean @default(true)
  currency Currency @relation(fields: [currencyId], references: [id])
  holdings InvestmentHolding[]
  transactions InvestmentTransaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([symbol])
  @@index([assetType, countryCode])
}

model InvestmentHolding {
  id String @id @default(uuid())
  accountId String
  assetId String
  quantity Decimal @default(0)
  costBasis Decimal @default(0)
  currentPrice Decimal?
  priceAsOf DateTime?
  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  transactions InvestmentTransaction[]
  @@unique([accountId, assetId])
  @@index([assetId])
}

model InvestmentTransaction {
  id String @id @default(uuid())
  accountId String
  assetId String
  holdingId String?
  transactionType InvestmentTransactionType
  transactionDate DateTime
  quantity Decimal @default(0)
  unitPrice Decimal @default(0)
  grossAmount Decimal @default(0)
  feeAmount Decimal @default(0)
  taxAmount Decimal @default(0)
  otherCharges Decimal @default(0)
  totalCashAmount Decimal @default(0)
  netCashAmount Decimal @default(0)
  costBasisAmount Decimal @default(0)
  realizedGainLoss Decimal?
  fundingCashAccountId String?
  fundingWalletId String?
  currencyId String
  note String?
  feeRuleSnapshot String?
  status String @default("ACTUAL")
  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  holding InvestmentHolding? @relation(fields: [holdingId], references: [id], onDelete: SetNull)
  currency Currency @relation(fields: [currencyId], references: [id])
  fundingWallet Wallet? @relation("InvestmentFundingWallet", fields: [fundingWalletId], references: [id], onDelete: SetNull)
  fundingCashAccount InvestmentCashAccount? @relation(fields: [fundingCashAccountId], references: [id], onDelete: SetNull)
  cashMovements InvestmentCashMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([accountId, transactionDate])
  @@index([assetId, transactionDate])
  @@index([transactionType, transactionDate])
}

model InvestmentFeeRule {
  id String @id @default(uuid())
  providerId String
  assetType InvestmentAssetType
  transactionType InvestmentTransactionType
  feeRate Decimal @default(0)
  taxRate Decimal @default(0)
  fixedFee Decimal @default(0)
  effectiveFrom DateTime
  effectiveTo DateTime?
  sourceUrl String?
  sourceLabel String?
  note String?
  provider InvestmentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([providerId, assetType, transactionType, effectiveFrom])
}

enum ReconciliationSourceType { BANK_STATEMENT CREDIT_CARD_STATEMENT }
enum ReconciliationSessionStatus { REVIEWING COMPLETED CANCELLED }
enum ReconciliationSourceSide { STATEMENT OKANE }
enum ReconciliationDirection { DEBIT CREDIT UNKNOWN }
enum ReconciliationMatchStatus { MATCHED POSSIBLE_MATCH CONFLICT STATEMENT_ONLY OKANE_ONLY }
enum ReconciliationResolution { PENDING ACCEPT_MATCH ADD_INCOMPLETE IGNORE KEEP DELETE }
enum InstallmentPlanStatus { ACTIVE COMPLETED CANCELLED }
enum SplitBillStatus { DRAFT OPEN SETTLED CANCELLED }
enum SplitBillItemMethod { EQUAL PRO_RATA }
enum ReceivableStatus { OUTSTANDING PARTIALLY_RECEIVED RECEIVED OVERDUE }
enum TransactionKind { STANDARD REIMBURSEMENT }
enum TransferOrigin { MANUAL CREDIT_CARD_PAYMENT }
enum WalletType { CASH BANK_ACCOUNT CREDIT_CARD DEBIT_CARD E_WALLET FOREIGN_CASH INVESTMENT }
enum CategoryType { INCOME EXPENSE }
enum TransactionType { INCOME EXPENSE }
enum CreditCardStatementStatus { UNPAID PARTIALLY_PAID PAID OVERDUE }
enum InvestmentAccountType { CASH PORTFOLIO COMBINED }
enum InvestmentAssetType { STOCK MUTUAL_FUND ETF BOND GOLD OTHER }
enum InvestmentTransactionType { BUY SELL DIVIDEND INTEREST COUPON FEE TAX TRANSFER_IN TRANSFER_OUT ADJUSTMENT SPLIT BONUS }
enum InvestmentCashMovementType { DEPOSIT WITHDRAWAL BUY_SETTLEMENT SELL_SETTLEMENT ADJUSTMENT }
