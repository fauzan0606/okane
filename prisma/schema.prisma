generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Currency {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  symbol        String
  decimalPlaces Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  wallets       Wallet[]
  receivables   Receivable[]
}

model Wallet {
  id             String             @id @default(uuid())
  name           String
  walletType     WalletType
  currencyId     String
  currentBalance Decimal            @default(0)
  balanceAsOf    DateTime?
  bank           String?
  color          String?
  icon           String?
  note           String?
  sortOrder      Int                @default(0)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  creditCard     CreditCardProfile?
  currency       Currency           @relation(fields: [currencyId], references: [id])
  transactions   Transaction[]
  receivablePayments ReceivablePayment[]
  sourceReceivables Receivable[]     @relation("ReceivableSourceWallet")

  @@index([currencyId])
}

model CreditCardProfile {
  id            String                     @id @default(uuid())
  walletId      String                     @unique
  creditLimit   Decimal                    @default(0)
  billingDate   Int
  dueDate       Int
  rewardProgram String?
  rewardPoint   Decimal                    @default(0)
  annualFee     Decimal?
  annualFeeDate Int?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  wallet        Wallet                     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  statements    CreditCardStatement[]
}

model CreditCardStatement {
  id                   String                     @id @default(uuid())
  creditCardId         String
  periodStart          DateTime
  periodEnd            DateTime
  statementDate        DateTime
  dueDate              DateTime
  calculatedAmount     Decimal                    @default(0)
  actualAmount         Decimal?
  paidAmount           Decimal                    @default(0)
  paidAt               DateTime?
  paymentTransactionId String?
  status               CreditCardStatementStatus @default(UNPAID)
  note                 String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  creditCard            CreditCardProfile          @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  payments              CreditCardStatementPayment[]

  @@unique([creditCardId, periodStart, periodEnd])
  @@index([creditCardId, dueDate])
}

model CreditCardStatementPayment {
  id          String               @id @default(uuid())
  statementId String
  amount      Decimal
  paidAt      DateTime
  note        String?
  createdAt   DateTime             @default(now())
  statement   CreditCardStatement  @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId, paidAt])
}

model Category {
  id String @id @default(uuid())
  name String
  type CategoryType
  icon String?
  color String?
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
}

model Payee {
  id String @id @default(uuid())
  name String
  note String?
  sortOrder Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
}

model Transaction {
  id String @id @default(uuid())
  transactionDate DateTime
  type TransactionType
  kind TransactionKind @default(STANDARD)
  amount Decimal
  note String?
  walletId String
  wallet Wallet @relation(fields: [walletId], references: [id])
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id])
  payeeId String?
  payee Payee? @relation(fields: [payeeId], references: [id])
  installmentPlan InstallmentPlan?
  receivablePayment ReceivablePayment?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstallmentPlan {
  id                String               @id @default(uuid())
  transactionId     String               @unique
  totalAmount       Decimal
  feeAmount         Decimal              @default(0)
  installmentAmount Decimal
  tenorMonths       Int
  startDate         DateTime
  status            InstallmentPlanStatus @default(ACTIVE)
  transaction       Transaction           @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([startDate, status])
}

model Receivable {
  id                  String             @id @default(uuid())
  personName          String
  description         String
  amount              Decimal
  receivedAmount      Decimal            @default(0)
  currencyId          String
  sourceWalletId      String?
  loanDate            DateTime           @default(now())
  dueDate             DateTime?
  status              ReceivableStatus   @default(OUTSTANDING)
  sourceTransactionId String?
  currency            Currency           @relation(fields: [currencyId], references: [id])
  sourceWallet        Wallet?            @relation("ReceivableSourceWallet", fields: [sourceWalletId], references: [id], onDelete: SetNull)
  payments            ReceivablePayment[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status, dueDate])
  @@index([currencyId, status])
  @@index([sourceWalletId, status])
}

model ReceivablePayment {
  id            String      @id @default(uuid())
  receivableId  String
  amount        Decimal
  receivedAt    DateTime
  walletId      String
  transactionId String      @unique
  note          String?
  receivable    Receivable  @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  wallet        Wallet      @relation(fields: [walletId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([receivableId, receivedAt])
}

enum InstallmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReceivableStatus {
  OUTSTANDING
  PARTIALLY_RECEIVED
  RECEIVED
  OVERDUE
}

enum TransactionKind {
  STANDARD
  REIMBURSEMENT
}

enum WalletType {
  CASH
  BANK_ACCOUNT
  CREDIT_CARD
  DEBIT_CARD
  E_WALLET
  FOREIGN_CASH
  INVESTMENT
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CreditCardStatementStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}
